{
	"name": "HTML tags for SEO analysis",
	"version": "4.0",
	"manifest_version": 3,
	"description": "Inspect SEO meta tags, headings, images, links, content, structured data and indexability of the active tab.",
	"icons": { "16": "icon.png",
		"48": "icon48.png",
		"64": "icon64.png",
		"128": "icon128.png"
	},
	"permissions": [
		"activeTab",
		"scripting",
		"storage",
		"webRequest"
	],
	"host_permissions": [
		"<all_urls>"
	],
	"background": {
		"service_worker": "background.js"
	},
	"content_scripts": [
		{
			"matches": ["<all_urls>"],
			"js": ["analyzer.js", "content.js"],
			"run_at": "document_idle"
		}
	],
	"action": {
		"default_popup": "popup.html",
		"default_icon": "icon.png"
	}
}
